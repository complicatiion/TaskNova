<?xml version="1.0" encoding="utf-8"?>
<!--
  TaskNova portable release (Visual Studio: right-click TaskNova.App › Publish › "Portable" › Publish).
  Publishes Native AOT for win-x64 into artifacts\publish\TaskNova. Afterwards the target "TaskNovaRelease"
  (TaskNova.App.csproj) writes the portable marker, packs tasknova_v<version>_portable.zip (+ .sha256) and,
  if Inno Setup 6 is installed, compiles build\installer\tasknova.iss into tasknova_v<version>_setup.exe (+ .sha256).
  Command line: dotnet publish src\TaskNova.App\TaskNova.App.csproj -p:PublishProfile=Portable
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\TaskNova\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <!-- Marks this as the release publish: the ZIP / setup target runs only for it -->
    <TaskNovaRelease>true</TaskNovaRelease>
  </PropertyGroup>
</Project>
