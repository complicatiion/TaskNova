<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:TaskNova.App.Controls"
        xmlns:vm="using:TaskNova.App.ViewModels"
        x:Class="TaskNova.App.Views.MiniMonitorWindow"
        x:DataType="vm:MiniMonitorViewModel"
        Title="TaskNova · Mini Monitor"
        Icon="/Assets/tasknova.ico"
        Width="310" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Window.Resources>
    <!-- Line of an expanded detail: icon, name (+ sub line), value, small bar -->
    <DataTemplate x:Key="MiniLineTemplate" x:DataType="vm:MiniLine">
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
        <Image Width="14" Height="14" Margin="0,0,6,0" Source="{Binding Icon}" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
               VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" FontSize="11" Text="{Binding Sub}" IsVisible="{Binding HasSub}" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <!-- Compact monitor: drag the frame to move, double-click opens TaskNova, click a metric for its details -->
  <Border Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12"
          Padding="10,8,10,10" x:Name="Frame">
    <StackPanel Spacing="4">
      <StackPanel.Styles>
        <Style Selector="Border.chartframe">
          <Setter Property="Height" Value="26" />
        </Style>
      </StackPanel.Styles>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="2,0,0,4">
        <Border Classes="logo" Width="18" Height="18" Margin="0,0,8,0" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
          <Run Text="TaskNova" FontWeight="Bold" />
          <Run Text=" · Mini Monitor" Foreground="{DynamicResource BrushTextSecondary}" />
        </TextBlock>
        <Button Grid.Column="2" Classes="icon small" Click="OnOpenMain" ToolTip.Tip="{DynamicResource TipOpenTaskNova}">
          <PathIcon Data="{StaticResource IconOpenInNew}" />
        </Button>
        <Button Grid.Column="3" Classes="icon small" Click="OnClose" ToolTip.Tip="{DynamicResource BtnClose}">
          <PathIcon Data="{StaticResource IconClose}" />
        </Button>
      </Grid>

      <!-- CPU -->
      <Button Classes="minirow" Command="{Binding ToggleCommand}" CommandParameter="cpu">
        <Grid ColumnDefinitions="48,64,*">
          <TextBlock Classes="minilabel" Text="CPU" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Grid.Column="2" Classes="chartframe">
            <ctl:SparkChart Series="{Binding Metrics.Cpu}" Maximum="100" Fill="{Binding ChartFill}" Stroke="{DynamicResource BrushAccent}" />
          </Border>
        </Grid>
      </Button>
      <StackPanel IsVisible="{Binding CpuExpanded}" Margin="8,2,8,6" Spacing="4">
        <Border Classes="chartframe" Height="70">
          <ctl:SparkChart Series="{Binding Metrics.Cpu}" Maximum="100" Fill="{Binding ChartFill}" Stroke="{DynamicResource BrushAccent}" />
        </Border>
        <TextBlock Classes="muted" FontSize="11" Text="{Binding CpuDetail}" />
        <ItemsControl ItemsSource="{Binding TopCpu}" ItemTemplate="{StaticResource MiniLineTemplate}" />
      </StackPanel>

      <!-- RAM -->
      <Button Classes="minirow" Command="{Binding ToggleCommand}" CommandParameter="ram">
        <Grid ColumnDefinitions="48,64,*">
          <TextBlock Classes="minilabel" Text="RAM" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding RamText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Grid.Column="2" Classes="chartframe">
            <ctl:SparkChart Series="{Binding Metrics.Memory}" Maximum="100" Fill="{Binding ChartFill}" Stroke="{DynamicResource BrushAccent}" />
          </Border>
        </Grid>
      </Button>
      <StackPanel IsVisible="{Binding RamExpanded}" Margin="8,2,8,6" Spacing="4">
        <TextBlock Classes="muted" FontSize="11" Text="{Binding RamDetail}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" FontSize="11" Text="{Binding CommitDetail}" />
        <ItemsControl ItemsSource="{Binding TopRam}" ItemTemplate="{StaticResource MiniLineTemplate}" />
      </StackPanel>

      <!-- Disk -->
      <Button Classes="minirow" Command="{Binding ToggleCommand}" CommandParameter="disk">
        <Grid ColumnDefinitions="48,64,*">
          <TextBlock Classes="minilabel" Text="{DynamicResource MiniDisk}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding DiskText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Grid.Column="2" Classes="chartframe">
            <ctl:SparkChart Series="{Binding Metrics.DiskTotal}" Maximum="100" Fill="{Binding ChartFill}" Stroke="{DynamicResource BrushAccent}" />
          </Border>
        </Grid>
      </Button>
      <ItemsControl IsVisible="{Binding DiskExpanded}" Margin="8,2,8,6" ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource MiniLineTemplate}" />

      <!-- Network -->
      <Button Classes="minirow" Command="{Binding ToggleCommand}" CommandParameter="net">
        <Grid ColumnDefinitions="48,64,*">
          <TextBlock Classes="minilabel" Text="{DynamicResource MiniNetwork}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding NetworkText}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
          <Border Grid.Column="2" Classes="chartframe">
            <ctl:SparkChart Series="{Binding Metrics.NetworkTotal}" Maximum="NaN" Fill="{Binding ChartFill}" Stroke="{DynamicResource BrushAccent}" />
          </Border>
        </Grid>
      </Button>
      <ItemsControl IsVisible="{Binding NetExpanded}" Margin="8,2,8,6" ItemsSource="{Binding Adapters}" ItemTemplate="{StaticResource MiniLineTemplate}" />
    </StackPanel>
  </Border>
</Window>
