<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:TaskNova.App.Controls"
             xmlns:vm="using:TaskNova.App.ViewModels"
             x:Class="TaskNova.App.Views.NetworkView"
             x:DataType="vm:NetworkViewModel">

  <Grid RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <ItemsControl Classes="pills" ItemsSource="{Binding Stats}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ToggleButton Classes="chip" IsChecked="{Binding ShowListening}">
          <ctl:IconLabel Icon="{StaticResource IconEarth}" IconSize="14" Text="{DynamicResource ChipListening}" />
        </ToggleButton>
        <ToggleButton Classes="chip" IsChecked="{Binding ShowUdp}">
          <ctl:IconLabel Icon="{StaticResource IconSwapVertical}" IconSize="14" Text="UDP" />
        </ToggleButton>
        <Button Classes="tool" Command="{Binding GoToProcessesCommand}" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="{DynamicResource ActShowInProcesses}">
          <ToolTip.Tip><ctl:TipContent Title="{DynamicResource ActShowInProcesses}" Text="{DynamicResource TipShowProcessesDesc}" /></ToolTip.Tip>
          <PathIcon Data="{StaticResource IconApplicationOutline}" />
        </Button>
        <Button Classes="tool" Command="{Binding GoToProcessCommand}" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="{DynamicResource ActDetails}">
          <ToolTip.Tip><ctl:TipContent Title="{DynamicResource ActDetails}" Text="{DynamicResource TipDetailsDesc}" /></ToolTip.Tip>
          <PathIcon Data="{StaticResource IconFormatListBulleted}" />
        </Button>
      </StackPanel>
    </Grid>
    <!-- Adapter cards: 2 per row in a normal window, more when the page is wide (columns set from code) -->
    <ItemsControl Grid.Row="1" x:Name="AdapterList" ItemsSource="{Binding Adapters}" Margin="0,0,-12,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AdapterCard">
          <Border Classes="kpitile" Margin="0,0,12,12" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Data="{Binding Icon}" Width="20" Height="20" Foreground="{DynamicResource BrushAccentText}" Margin="0,0,10,0" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" />
                <TextBlock Classes="muted small" Text="{Binding Throughput}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Grid.Row="2" Classes="tablecard">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="thead">
          <Grid ColumnDefinitions="*,70,80,190,220,120,200">
            <Button Classes="th" Command="{Binding SortCommand}" CommandParameter="process"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=process}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColProcess}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="th num" Command="{Binding SortCommand}" CommandParameter="pid"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=pid}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="PID" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="th" Command="{Binding SortCommand}" CommandParameter="protocol"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=protocol}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColProtocol}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="th" Command="{Binding SortCommand}" CommandParameter="local"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=local}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColLocal}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="th" Command="{Binding SortCommand}" CommandParameter="remote"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=remote}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColRemote}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="5" Classes="th" Command="{Binding SortCommand}" CommandParameter="state"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=state}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColState}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="6" Classes="th" Command="{Binding SortCommand}" CommandParameter="host"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=host}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColRemoteHost}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <ListBox x:Name="ConnectionList" Classes="table" AutoScrollToSelectedItem="False" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ConnectionRow">
              <Grid ColumnDefinitions="*,70,80,190,220,120,200" Background="Transparent">
                <DockPanel>
                  <Panel DockPanel.Dock="Left" Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="16" Height="16" />
                  </Panel>
                  <TextBlock Classes="cell" Margin="8,0,6,0" Text="{Binding ProcessName}" />
                </DockPanel>
                <TextBlock Grid.Column="1" Classes="cell num dim" Text="{Binding Pid}" />
                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Protocol}" />
                <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Local}" FontFamily="{DynamicResource MonoFont}" FontSize="12" />
                <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Remote}" FontFamily="{DynamicResource MonoFont}" FontSize="12" />
                <TextBlock Grid.Column="5" Classes="cell dim" Text="{Binding State}" />
                <TextBlock Grid.Column="6" Classes="cell dim" Text="{Binding RemoteHost}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{DynamicResource ActShowInProcesses}" Command="{Binding GoToProcessesCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconApplicationOutline}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActDetails}" Command="{Binding GoToProcessCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconFormatListBulleted}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActCopyRow}" Command="{Binding CopyRowCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconCopy}" /></MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
