<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:TaskNova.App.Controls"
        xmlns:vm="using:TaskNova.App.ViewModels"
        xmlns:pw="using:TaskNova.Platform.Windows"
        x:Class="TaskNova.App.Views.ProcessWindow"
        x:DataType="vm:ProcessWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/tasknova.ico"
        Width="820" Height="620"
        MinWidth="560" MinHeight="420"
        Background="{DynamicResource BrushBgApp}"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="20,16,20,16">
    <!-- Header: icon, name, live values; actions right (main action rightmost) -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
      <Panel Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
        <Image Source="{Binding Row.Icon}" Width="32" Height="32" />
        <PathIcon Data="{StaticResource IconApplicationOutline}" Width="26" Height="26" IsVisible="{Binding !Row.HasIcon}"
                  Foreground="{DynamicResource BrushTextSecondary}" />
      </Panel>
      <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
        <TextBlock Classes="h2" Text="{Binding Row.DisplayName}" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="statpill">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding Row.Pid}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushAccentText}" />
              <TextBlock Text="PID" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
            </StackPanel>
          </Border>
          <Border Classes="statpill">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding CpuText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushAccentText}" />
              <TextBlock Text="CPU" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
            </StackPanel>
          </Border>
          <Border Classes="statpill">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding MemoryText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushAccentText}" />
              <TextBlock Text="{DynamicResource PillMemory}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
            </StackPanel>
          </Border>
          <Border Classes="badge moderate" IsVisible="{Binding HasEnded}">
            <TextBlock Text="{DynamicResource BadgeEnded}" />
          </Border>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="tool" Command="{Binding OpenLocationCommand}" AutomationProperties.Name="{DynamicResource ActOpenLocation}">
          <ToolTip.Tip><ctl:TipContent Title="{DynamicResource ActOpenLocation}" Text="{DynamicResource TipOpenLocationDesc}" /></ToolTip.Tip>
          <PathIcon Data="{StaticResource IconFolderOpen}" />
        </Button>
        <Button Classes="tool" Command="{Binding ShowInProcessesCommand}" AutomationProperties.Name="{DynamicResource BtnShowProcesses}">
          <ToolTip.Tip><ctl:TipContent Title="{DynamicResource BtnShowProcesses}" Text="{DynamicResource TipShowProcessesDesc}" /></ToolTip.Tip>
          <PathIcon Data="{StaticResource IconFormatListBulleted}" />
        </Button>
        <Button Classes="tool danger" Command="{Binding EndCommand}" IsEnabled="{Binding !HasEnded}" AutomationProperties.Name="{DynamicResource ActEndTask}">
          <ToolTip.Tip><ctl:TipContent Title="{DynamicResource ActEndTask}" Text="{DynamicResource TipEndDesc}" /></ToolTip.Tip>
          <PathIcon Data="{StaticResource IconCloseOctagon}" />
        </Button>
      </StackPanel>
    </Grid>

    <TabControl>
      <!-- General: live charts + facts -->
      <TabItem Header="{DynamicResource TabGeneral}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" Margin="0,10,6,6">
            <Grid ColumnDefinitions="*,14,*">
              <Border Classes="kpitile">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h3" Text="CPU" />
                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontWeight="SemiBold" />
                  </Grid>
                  <Border Classes="chartframe" Height="80">
                    <ctl:SparkChart Series="{Binding CpuHistory}" Maximum="100" Fill="{Binding ChartFill}" Stroke="{DynamicResource BrushAccent}" />
                  </Border>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="kpitile">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h3" Text="{DynamicResource DevMemory}" />
                    <TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontWeight="SemiBold" />
                  </Grid>
                  <Border Classes="chartframe" Height="80">
                    <ctl:SparkChart Series="{Binding MemoryHistory}" Maximum="NaN" Fill="{Binding ChartFill}" Stroke="{DynamicResource BrushAccent}" />
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="card">
              <StackPanel Spacing="4">
                <ItemsControl ItemsSource="{Binding Facts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FactLine">
                      <Grid ColumnDefinitions="150,*" Margin="0,3">
                        <TextBlock Classes="statlabel" Text="{Binding Label}" VerticalAlignment="Top" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="150,*" Margin="0,3">
                  <TextBlock Classes="statlabel" Text="{DynamicResource ColThreads}" />
                  <TextBlock Grid.Column="1" Text="{Binding ThreadsText}" />
                </Grid>
                <Grid ColumnDefinitions="150,*" Margin="0,3">
                  <TextBlock Classes="statlabel" Text="{DynamicResource ColHandles}" />
                  <TextBlock Grid.Column="1" Text="{Binding HandlesText}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Modules: loaded DLLs, read on demand -->
      <TabItem Header="{DynamicResource TabModules}">
        <DockPanel Margin="0,10,0,0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Classes="muted small" Text="{Binding ModulesSummary}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="tool" Command="{Binding LoadModulesCommand}" IsEnabled="{Binding !ModulesLoading}"
                    AutomationProperties.Name="{DynamicResource BtnRefresh}">
              <ToolTip.Tip><ctl:TipContent Title="{DynamicResource BtnLoadModules}" Text="{DynamicResource TipLoadModulesDesc}" /></ToolTip.Tip>
              <PathIcon Data="{StaticResource IconRefresh}" />
            </Button>
          </Grid>
          <Border Classes="tablecard">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="thead">
                <Grid ColumnDefinitions="200,*,130,90">
                  <TextBlock Classes="th" Text="{DynamicResource ColName}" Margin="10,0" />
                  <TextBlock Grid.Column="1" Classes="th" Text="{DynamicResource ColPath}" Margin="10,0" />
                  <TextBlock Grid.Column="2" Classes="th" Text="{DynamicResource ColBaseAddress}" Margin="10,0" />
                  <TextBlock Grid.Column="3" Classes="th" Text="{DynamicResource ColSize}" Margin="10,0" />
                </Grid>
              </Border>
              <ListBox Classes="table" ItemsSource="{Binding Modules}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="pw:ModuleEntry">
                    <Grid ColumnDefinitions="200,*,130,90" Background="Transparent">
                      <TextBlock Classes="cell" Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="cell dim" Text="{Binding Path}" ToolTip.Tip="{Binding Path}" />
                      <TextBlock Grid.Column="2" Classes="cell dim" Text="{Binding BaseText}" FontFamily="{DynamicResource MonoFont}" FontSize="12" />
                      <TextBlock Grid.Column="3" Classes="cell num dim" Text="{Binding SizeText}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
