<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TaskNova.App.Views.AlertWindow"
        Title="TaskNova"
        Icon="/Assets/tasknova.ico"
        Width="360" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Opacity="0"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <!-- Small notification in the corner of the primary screen; click opens TaskNova, closes by itself after a few seconds -->
  <Border x:Name="Frame" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushAccentText}" BorderThickness="1"
          CornerRadius="12" Padding="14,12" Cursor="Hand">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <PathIcon x:Name="Glyph" Width="22" Height="22" Margin="0,2,12,0" VerticalAlignment="Top" Foreground="{DynamicResource BrushAccentText}" />
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="BodyText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
      </StackPanel>
      <Button Grid.Column="2" Classes="icon small" VerticalAlignment="Top" Click="OnClose" ToolTip.Tip="{DynamicResource BtnClose}">
        <PathIcon Data="{StaticResource IconClose}" />
      </Button>
    </Grid>
  </Border>
</Window>
