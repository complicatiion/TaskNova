<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:TaskNova.App.Controls"
             xmlns:vm="using:TaskNova.App.ViewModels"
             x:Class="TaskNova.App.Views.DetailsView"
             x:DataType="vm:DetailsViewModel">

  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <ItemsControl Classes="pills" ItemsSource="{Binding Stats}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="tool" Command="{Binding OpenLocationCommand}" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="{DynamicResource ActOpenLocation}">
          <ToolTip.Tip><ctl:TipContent Title="{DynamicResource ActOpenLocation}" Text="{DynamicResource TipOpenLocationDesc}" /></ToolTip.Tip>
          <PathIcon Data="{StaticResource IconFolderOpen}" />
        </Button>
        <Button Classes="tool" Command="{Binding ToggleSuspendCommand}" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="{DynamicResource ActSuspendResume}">
          <ToolTip.Tip><ctl:TipContent Title="{DynamicResource ActSuspendResume}" Text="{DynamicResource TipSuspendDesc}" /></ToolTip.Tip>
          <PathIcon Data="{StaticResource IconSnowflake}" />
        </Button>
        <Button Classes="tool danger" Command="{Binding EndTaskCommand}" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="{DynamicResource ActEndTask}">
          <ToolTip.Tip><ctl:TipContent Title="{DynamicResource ActEndTask}" Text="{DynamicResource TipEndDesc}" /></ToolTip.Tip>
          <PathIcon Data="{StaticResource IconCloseOctagon}" />
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Classes="tablecard">
      <DockPanel>
        <!-- Header scrolls horizontally together with the rows (code-behind) -->
        <Border DockPanel.Dock="Top" Classes="thead" ToolTip.Tip="{DynamicResource TipColumns}">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{DynamicResource MenuColumns}" IsEnabled="False" />
              <Separator />
              <MenuItem Header="PID" ToggleType="CheckBox" IsChecked="{Binding Columns.Pid.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColStatus}" ToggleType="CheckBox" IsChecked="{Binding Columns.Status.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColUser}" ToggleType="CheckBox" IsChecked="{Binding Columns.User.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColSession}" ToggleType="CheckBox" IsChecked="{Binding Columns.Session.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColCpu}" ToggleType="CheckBox" IsChecked="{Binding Columns.Cpu.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColCpuTime}" ToggleType="CheckBox" IsChecked="{Binding Columns.CpuTime.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColMemory}" ToggleType="CheckBox" IsChecked="{Binding Columns.Memory.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColWorkingSet}" ToggleType="CheckBox" IsChecked="{Binding Columns.WorkingSet.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColPrivateBytes}" ToggleType="CheckBox" IsChecked="{Binding Columns.Private.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColThreads}" ToggleType="CheckBox" IsChecked="{Binding Columns.Threads.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColHandles}" ToggleType="CheckBox" IsChecked="{Binding Columns.Handles.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColPriority}" ToggleType="CheckBox" IsChecked="{Binding Columns.Priority.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColIo}" ToggleType="CheckBox" IsChecked="{Binding Columns.Io.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColIoRead}" ToggleType="CheckBox" IsChecked="{Binding Columns.IoRead.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColIoWrite}" ToggleType="CheckBox" IsChecked="{Binding Columns.IoWrite.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColGpu}" ToggleType="CheckBox" IsChecked="{Binding Columns.Gpu.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColPlatform}" ToggleType="CheckBox" IsChecked="{Binding Columns.Platform.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColDescription}" ToggleType="CheckBox" IsChecked="{Binding Columns.Description.Visible, Mode=TwoWay}" />
              <MenuItem Header="{DynamicResource ColCommandLine}" ToggleType="CheckBox" IsChecked="{Binding Columns.CommandLine.Visible, Mode=TwoWay}" />
              <Separator />
              <MenuItem Header="{DynamicResource ActResetColumns}" Command="{Binding Columns.ResetCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconRestart}" /></MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </Border.ContextMenu>
          <ScrollViewer x:Name="HeadScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="200,70,96,130,70,72,90,100,104,104,74,80,110,96,100,100,70,80,220,640" ctl:GridColumns.Layout="{Binding Columns}" ctl:GridColumns.Offset="0">
            <Button Grid.Column="0" Classes="th" Command="{Binding SortCommand}" CommandParameter="name"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=name}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColName}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="th num" Command="{Binding SortCommand}" CommandParameter="pid"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=pid}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="PID" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="th" Command="{Binding SortCommand}" CommandParameter="status"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=status}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColStatus}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="th" Command="{Binding SortCommand}" CommandParameter="user"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=user}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColUser}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="th num" Command="{Binding SortCommand}" CommandParameter="session"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=session}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="{DynamicResource ColSession}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="5" Classes="th num" Command="{Binding SortCommand}" CommandParameter="cpu"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=cpu}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="{DynamicResource ColCpu}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="6" Classes="th num" Command="{Binding SortCommand}" CommandParameter="cputime"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=cputime}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="{DynamicResource ColCpuTime}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="7" Classes="th num" Command="{Binding SortCommand}" CommandParameter="memory"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=memory}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="{DynamicResource ColMemory}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="8" Classes="th num" Command="{Binding SortCommand}" CommandParameter="workingset"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=workingset}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="{DynamicResource ColWorkingSet}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="9" Classes="th num" Command="{Binding SortCommand}" CommandParameter="private"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=private}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="{DynamicResource ColPrivateBytes}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="10" Classes="th num" Command="{Binding SortCommand}" CommandParameter="threads"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=threads}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="{DynamicResource ColThreads}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="11" Classes="th num" Command="{Binding SortCommand}" CommandParameter="handles"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=handles}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="{DynamicResource ColHandles}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="12" Classes="th" Command="{Binding SortCommand}" CommandParameter="priority"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=priority}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColPriority}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="13" Classes="th num" Command="{Binding SortCommand}" CommandParameter="io"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=io}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="{DynamicResource ColIo}" />
              </StackPanel>
            </Button>
            <TextBlock Grid.Column="14" Classes="th" Text="{DynamicResource ColIoRead}" HorizontalAlignment="Right" Margin="10,0" />
            <TextBlock Grid.Column="15" Classes="th" Text="{DynamicResource ColIoWrite}" HorizontalAlignment="Right" Margin="10,0" />
            <Button Grid.Column="16" Classes="th num" Command="{Binding SortCommand}" CommandParameter="gpu"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=gpu}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconChevronDown}" />
                <TextBlock Classes="th" Text="{DynamicResource ColGpu}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="17" Classes="th" Command="{Binding SortCommand}" CommandParameter="platform"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=platform}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColPlatform}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="18" Classes="th" Command="{Binding SortCommand}" CommandParameter="description"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=description}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColDescription}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="19" Classes="th" Command="{Binding SortCommand}" CommandParameter="commandline"
                    Classes.sorted="{Binding SortColumn, Converter={x:Static ctl:Converters.EqualsParameter}, ConverterParameter=commandline}"
                    Classes.ascending="{Binding !SortDescending}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="{DynamicResource ColCommandLine}" />
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </StackPanel>
            </Button>
                          <ctl:ColumnGrip Grid.Column="0" Spec="{Binding Columns.Name}" />
              <ctl:ColumnGrip Grid.Column="1" Spec="{Binding Columns.Pid}" />
              <ctl:ColumnGrip Grid.Column="2" Spec="{Binding Columns.Status}" />
              <ctl:ColumnGrip Grid.Column="3" Spec="{Binding Columns.User}" />
              <ctl:ColumnGrip Grid.Column="4" Spec="{Binding Columns.Session}" />
              <ctl:ColumnGrip Grid.Column="5" Spec="{Binding Columns.Cpu}" />
              <ctl:ColumnGrip Grid.Column="6" Spec="{Binding Columns.CpuTime}" />
              <ctl:ColumnGrip Grid.Column="7" Spec="{Binding Columns.Memory}" />
              <ctl:ColumnGrip Grid.Column="8" Spec="{Binding Columns.WorkingSet}" />
              <ctl:ColumnGrip Grid.Column="9" Spec="{Binding Columns.Private}" />
              <ctl:ColumnGrip Grid.Column="10" Spec="{Binding Columns.Threads}" />
              <ctl:ColumnGrip Grid.Column="11" Spec="{Binding Columns.Handles}" />
              <ctl:ColumnGrip Grid.Column="12" Spec="{Binding Columns.Priority}" />
              <ctl:ColumnGrip Grid.Column="13" Spec="{Binding Columns.Io}" />
              <ctl:ColumnGrip Grid.Column="14" Spec="{Binding Columns.IoRead}" />
              <ctl:ColumnGrip Grid.Column="15" Spec="{Binding Columns.IoWrite}" />
              <ctl:ColumnGrip Grid.Column="16" Spec="{Binding Columns.Gpu}" />
              <ctl:ColumnGrip Grid.Column="17" Spec="{Binding Columns.Platform}" />
              <ctl:ColumnGrip Grid.Column="18" Spec="{Binding Columns.Description}" />
              <ctl:ColumnGrip Grid.Column="19" Spec="{Binding Columns.CommandLine}" />
            </Grid>
          </ScrollViewer>
        </Border>

        <ListBox x:Name="List" Classes="table" AutoScrollToSelectedItem="False" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.KeyBindings>
            <KeyBinding Gesture="Delete" Command="{Binding EndTaskCommand}" />
            <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
          </ListBox.KeyBindings>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProcessRow">
              <Grid ColumnDefinitions="200,70,96,130,70,72,90,100,104,104,74,80,110,96,100,100,70,80,220,640" Background="Transparent"
                  ctl:GridColumns.Layout="{Binding $parent[UserControl].((vm:DetailsViewModel)DataContext).Columns}" ctl:GridColumns.Offset="0">
                <DockPanel Grid.Column="0">
                  <Panel DockPanel.Dock="Left" Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="16" Height="16" />
                    <PathIcon Data="{StaticResource IconApplicationOutline}" Width="15" Height="15" IsVisible="{Binding !HasIcon}"
                              Foreground="{DynamicResource BrushTextSecondary}" />
                  </Panel>
                  <PathIcon DockPanel.Dock="Right" Data="{StaticResource IconShieldAlert}" Width="14" Height="14" Margin="0,0,6,0"
                            Foreground="{DynamicResource BrushModerate}" IsVisible="{Binding HasWarning}" ToolTip.Tip="{Binding WarningTip}" />
                  <TextBlock Classes="cell" Margin="8,0,6,0" Text="{Binding Name}" />
                </DockPanel>
                <TextBlock Grid.Column="1" Classes="cell num dim" Text="{Binding Pid}" />
                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding StatusText}" />
                <TextBlock Grid.Column="3" Classes="cell" Text="{Binding UserText}" />
                <TextBlock Grid.Column="4" Classes="cell num dim" Text="{Binding SessionId}" />
                <Border Grid.Column="5" Classes="heat" Background="{Binding CpuHeat}">
                  <TextBlock Classes="cell num" Text="{Binding CpuText}" />
                </Border>
                <TextBlock Grid.Column="6" Classes="cell num" Text="{Binding CpuTimeText}" />
                <Border Grid.Column="7" Classes="heat" Background="{Binding MemoryHeat}">
                  <TextBlock Classes="cell num" Text="{Binding MemoryText}" />
                </Border>
                <TextBlock Grid.Column="8" Classes="cell num" Text="{Binding WorkingSetText}" />
                <TextBlock Grid.Column="9" Classes="cell num" Text="{Binding PrivateBytesText}" />
                <TextBlock Grid.Column="10" Classes="cell num" Text="{Binding Threads}" />
                <TextBlock Grid.Column="11" Classes="cell num" Text="{Binding Handles}" />
                <TextBlock Grid.Column="12" Classes="cell" Text="{Binding PriorityText}" />
                <Border Grid.Column="13" Classes="heat" Background="{Binding IoHeat}">
                  <TextBlock Classes="cell num" Text="{Binding IoText}" />
                </Border>
                <TextBlock Grid.Column="14" Classes="cell num" Text="{Binding IoReadText}" />
                <TextBlock Grid.Column="15" Classes="cell num" Text="{Binding IoWriteText}" />
                <Border Grid.Column="16" Classes="heat" Background="{Binding GpuHeat}">
                  <TextBlock Classes="cell num" Text="{Binding GpuText}" />
                </Border>
                <TextBlock Grid.Column="17" Classes="cell" Text="{Binding Platform}" />
                <TextBlock Grid.Column="18" Classes="cell" Text="{Binding Description}" />
                <TextBlock Grid.Column="19" Classes="cell" Text="{Binding CommandLine}" FontFamily="{DynamicResource MonoFont}" FontSize="12" ToolTip.Tip="{Binding CommandLine}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{DynamicResource ActEndTask}" Command="{Binding EndTaskCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconCloseOctagon}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActEndTree}" Command="{Binding EndTreeCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconFileTree}" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="{DynamicResource ActSuspendResume}" Command="{Binding ToggleSuspendCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconSnowflake}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActPriority}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconSpeedometer}" /></MenuItem.Icon>
                <MenuItem Header="{DynamicResource PriorityRealtime}" Command="{Binding SetPriorityCommand}" CommandParameter="Realtime" />
                <MenuItem Header="{DynamicResource PriorityHigh}" Command="{Binding SetPriorityCommand}" CommandParameter="High" />
                <MenuItem Header="{DynamicResource PriorityAboveNormal}" Command="{Binding SetPriorityCommand}" CommandParameter="AboveNormal" />
                <MenuItem Header="{DynamicResource PriorityNormal}" Command="{Binding SetPriorityCommand}" CommandParameter="Normal" />
                <MenuItem Header="{DynamicResource PriorityBelowNormal}" Command="{Binding SetPriorityCommand}" CommandParameter="BelowNormal" />
                <MenuItem Header="{DynamicResource PriorityIdle}" Command="{Binding SetPriorityCommand}" CommandParameter="Idle" />
              </MenuItem>
              <MenuItem Header="{DynamicResource ActAffinity}" Command="{Binding AffinityCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconChip}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActEfficiency}" Command="{Binding EfficiencyCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconLeaf}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActDump}" Command="{Binding DumpCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconSave}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActWaitChain}" Command="{Binding WaitChainCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconTimerSand}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActRestartProcess}" Command="{Binding RestartProcessCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconRestart}" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="{DynamicResource ActOpenLocation}" Command="{Binding OpenLocationCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconFolderOpen}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActProcessWindow}" Command="{Binding ProcessWindowCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconWindowRestore}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActProperties}" Command="{Binding PropertiesCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconInfo}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActCopyDetails}" Command="{Binding CopyCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconCopy}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource ActServices}" Command="{Binding GoToServicesCommand}" IsEnabled="{Binding HasSelection}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconCogs}" /></MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
